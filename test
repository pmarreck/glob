#!/usr/bin/env bash

set -u

repo_root=$(CDPATH='' cd -- "${BASH_SOURCE[0]%/*}" && pwd)
failures=0

if [[ -z ${GLOB_ENGINE:-} ]]; then
	engine_out=$(nix build "$repo_root#engine" --no-link --print-out-paths)
	status=$?
	if (( status != 0 )) || [[ -z "$engine_out" ]]; then
		printf 'test: failed to prepare glob-engine through Nix\n' >&2
		exit 1
	fi
	GLOB_ENGINE="$engine_out/bin/glob-engine"
	export GLOB_ENGINE
fi

if [[ -n ${GLOB_BIN:-} ]]; then
	PATH="${GLOB_BIN%/*}:$PATH"
	export PATH
fi

run_suite() {
	local suite=$1
	"$suite"
	local status=$?
	if (( status != 0 )); then
		failures=$((failures + status))
	fi
}

run_suite "$repo_root/tests/cli/glob_test"
run_suite "$repo_root/tests/compat/dotfiles_glob_test"
run_suite "$repo_root/tests/compat/dotfiles_no_compgen_test"

if (( failures == 0 )); then
	printf 'All test suites passed.\n'
else
	printf '%d test suite failure(s).\n' "$failures" >&2
fi

exit "$failures"
